PORT=3001
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/inkloom

# --- AI provider (OpenAI-compatible chat/completions endpoint) ---

AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d


# Rate limits per IP (optional — defaults: 50 auth attempts / 15 min, 30 guest logins / hour)
# AUTH_RATE_MAX=50
# GUEST_RATE_MAX=30

# Password-reset e-mail (optional). Leave SMTP_HOST empty in dev:
# the 6-digit code is then printed in the server console instead.


SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

VITE_GITHUB_CLIENT_ID=

# ── Frontend (Vite) reads its OWN client/.env — these VITE_ vars here are unused
# leftovers and were pointing at the wrong port (4000). Fixed to match PORT above
# in case anything still reads them, but client/.env is the one that actually matters.

VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Old OpenRouter creds kept only as a fallback if AI_API_KEY is ever removed above.
# Not used right now since AI_API_KEY / AI_BASE_URL take priority in client.js.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free